# Copy this file to .env and fill only the values you use.

# Required for YouTube discovery and cooperation-content refresh.
YOUTUBE_API_KEY=

# Feishu defaults intentionally keep the interactive first-run experience:
# install lark-cli when needed, open the browser for OAuth, and create a Base.
FEISHU_AUTH_MODE=auto
FEISHU_CLI_PROFILE=kol-workflow
FEISHU_BASE_NAME=KOL网红开发工作流
FEISHU_AUTO_SETUP=true
FEISHU_AUTO_INSTALL=true
FEISHU_OPEN_BROWSER=true
FEISHU_AUTH_TIMEOUT_SECONDS=900
# FEISHU_LARK_CLI_PATH=

# Optional compatibility mode. Set all three values together.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_APP_TOKEN=
# Windows defaults to memory-only caching for legacy App tenant tokens.
# FEISHU_ALLOW_INSECURE_TOKEN_CACHE=false

# Required for automatic sample-logistics refresh and reminder delivery.
LOGISTICS_PROVIDER=17track
TRACK17_API_KEY=
LOGISTICS_HTTP_TIMEOUT_SECONDS=30
LOGISTICS_MAX_RETRIES=2
SAMPLE_LOGISTICS_TIMEZONE=Asia/Shanghai
SAMPLE_LOGISTICS_STALL_HOURS=72
SAMPLE_TRACKING_TABLE_ID=
SAMPLE_REMINDER_USER_OPEN_ID=

# Optional runtime settings.
# OUTPUT_DIR=./output
# LOG_LEVEL=INFO
# REGION=US
# LANG_CODE=en
# BRAND_EXCLUSION_FILE=brand_exclusions.json
