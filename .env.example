# ============================================================
# YouTube KOL 网红开发工作流 - 环境变量配置
# ============================================================
# 复制本文件为 .env 并填写实际值
# cp .env.example .env
# ============================================================

# YouTube Data API v3 密钥 (必填)
# 获取方式: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=你的YouTube_API_Key

# 飞书认证模式：auto（默认）/ cli / app
# auto: 同时配置 FEISHU_APP_TOKEN + FEISHU_APP_ID + FEISHU_APP_SECRET 时
#       兼容旧 App 模式；否则使用 lark-cli OAuth 自动设置。
FEISHU_AUTH_MODE=auto

# 旧 App 模式兼容配置（可选；三项需要同时提供）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_APP_TOKEN=               # 也可填写飞书 Base URL

# lark-cli OAuth 自动设置（均为可选配置）
# CLI OAuth 凭证由 lark-cli 保存到系统钥匙串，不写入 .env。
FEISHU_CLI_PROFILE=kol-workflow
FEISHU_BASE_NAME=KOL网红开发工作流
FEISHU_AUTO_SETUP=true
FEISHU_AUTO_INSTALL=true
FEISHU_OPEN_BROWSER=true
FEISHU_AUTH_TIMEOUT_SECONDS=900
# FEISHU_LARK_CLI_PATH=           # 留空时从 PATH 自动查找

# ============================================================
# 可选配置 (有默认值，通常无需修改)
# ============================================================

# 输出目录 (不设置时默认项目目录下 output)
# OUTPUT_DIR=./output

# 日志级别: DEBUG, INFO, WARNING (默认 INFO)
# LOG_LEVEL=INFO

# 搜索地区 (默认 US)
# REGION=US

# 搜索语言 (默认 en)
# LANG_CODE=en

# 品牌排除名单文件路径 (默认 brand_exclusions.json)
# BRAND_EXCLUSION_FILE=brand_exclusions.json

# ============================================================
# Legacy summary Feishu Base (20260623 merged output)
# ============================================================
# KOL_SUMMARY_20260623_APP_TOKEN=
# KOL_SUMMARY_20260623_SEARCH_TASKS_TABLE_ID=
# KOL_SUMMARY_20260623_SEARCH_VIDEOS_TABLE_ID=
# KOL_SUMMARY_20260623_INFLUENCERS_TABLE_ID=
# KOL_SUMMARY_20260623_INFLUENCER_VIDEOS_TABLE_ID=

# Optional relative paths. Relative values are resolved from project root.
# KOL_SUMMARY_BASE_SYNC_SCRIPT=../../outputs/kol_summary_20260623/sync_to_feishu.py
# KOL_SUMMARY_FEISHU_CONFIG_PATH=../../kol/.feishu_config.json
# KOL_SUMMARY_DEDUP_WORKBOOK_PATH=output/summary_20260623_merged/kol_summary_tables_dedup_influencers.xlsx
# KOL_SUMMARY_DEDUP_SYNC_STATS_PATH=output/summary_20260623_merged/sync_dedup_workbook_to_feishu_stats.json
# KOL_SUMMARY_DELETE_EMPTY_STATS_PATH=output/summary_20260623_merged/delete_empty_feishu_rows_stats.json
# KOL_SUMMARY_UPDATE_DESCRIPTIONS_STATS_PATH=output/summary_20260623_merged/update_channel_descriptions_stats.json
